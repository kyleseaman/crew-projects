{
  "name": "project-hub",
  "version": "0.4.2",
  "minKiroCrewVersion": "0.10.0",
  "displayName": "Projects",
  "description": "Projects as folders: repositories, default agent and instructions, every team-lead goal with its team, a Library, subscriptions, and what is waiting on you.",
  "author": "kyle",
  "iconPath": "assets/icon.png",
  "tags": [
    "agents",
    "orchestration",
    "visualization"
  ],
  "ui": {
    "entry": "dist/index.mjs",
    "pages": [
      {
        "route": "/apps/project-hub",
        "label": "Projects",
        "icon": "FolderKanban"
      }
    ]
  },
  "permissions": {
    "api": [
      "/api/chat/slots",
      "/api/chat/folders",
      "/api/autonudge",
      "/api/sessions",
      "/api/artifacts",
      "/api/project-schedules"
    ],
    "events": [
      "slots"
    ]
  }
}
